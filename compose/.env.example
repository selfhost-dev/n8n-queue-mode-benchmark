# Copy to .env next to docker-compose.yml and fill in. Generate each secret once, e.g. `openssl rand -hex 32`.
N8N_ENCRYPTION_KEY=        # same for every n8n process, never change it after the first start
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RUNNERS_AUTH_TOKEN=
N8N_PUBLIC_URL=http://<your-server-ip>:5678/
