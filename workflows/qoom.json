{
  "name": "QOOM worker killer",
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "qoom-0000-4000-8000-000000000000",
      "parameters": {
        "httpMethod": "POST",
        "path": "qoom",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ],
      "webhookId": "wait-220-0000-4000-8000-000000000000",
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      }
    },
    {
      "name": "Boom",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "manual",
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "f0",
              "name": "n",
              "value": "={{ Array.from({ length: 60000000 }, (_, i) => ({ i, s: 'x' + i })).length }}",
              "type": "number"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait": {
      "main": [
        [
          {
            "node": "Boom",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
